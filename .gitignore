Grading_Application.pdf

# ------------------------------------------------------------------------------
# Secrets and environment-specific files — never commit real values.
# ------------------------------------------------------------------------------
.env
.env.example
docker/certs/
# Local native tool binaries (e.g. the upstream xmlsec1 win64 build pysaml2
# shells out to — downloaded once, not a pip dependency; lives in .env via
# SAML_XMLSEC_BINARY_PATH). Public upstream tool, but a multi-MB binary blob
# has no place in source control.
tools/
**/secrets/
*.pem
!backend/tests/fixtures/*.pem

